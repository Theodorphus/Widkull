# Resend Email API (get key from https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Avsändaradress för utgående mail (måste vara verifierad domän i Resend).
# Under utveckling kan du använda onboarding@resend.dev
RESEND_FROM=onboarding@resend.dev

# Mottagare av kontakt-/förfrågningsmail. Sätt denna för att styra var mail landar.
RESEND_TO_OVERRIDE=info@wildkullpayroll.se

# Publik bas-URL för sidan (används i metadata/sitemap)
NEXT_PUBLIC_SITE_URL=https://wildkullpayroll.se
